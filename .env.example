# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set the same variables in Project Settings > Environment Variables
# for Production, Preview and Development.

# Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API > anon / publishable key.
# Safe in the browser: access is limited by RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never expose the service_role key with a NEXT_PUBLIC_ prefix.

# Server-only (T-23). Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to
# /api/cron/keepalive. Use a random string of 16+ characters, e.g. `openssl rand -hex 32`.
CRON_SECRET=
