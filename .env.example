# Copy to .env.local for local development (never commit .env.local).
# On Vercel, set the same variables in Project Settings > Environment Variables
# for Production, Preview and Development.

# Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API > anon / publishable key.
# Safe in the browser: access is limited by RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never expose the service_role key with a NEXT_PUBLIC_ prefix.
# No server-only secret is needed yet (T-01).
